# Application
NODE_ENV=development
PORT=3000

# Database
DB_TYPE=sqlite
DB_DATABASE=database.sqlite

# For PostgreSQL
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=password
# DB_DATABASE=nx_fullstack

# Plugins
PLUGINS_PATH=./plugins
PLUGINS_AUTO_LOAD=true

# Admin Dashboard
NEXT_PUBLIC_API_URL=http://localhost:3000

# Plugin Registry
PLUGIN_REGISTRY_URL=https://registry.nx-fullstack.com