{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@nx-fullstack/shared/config": ["libs/shared/config/src/index.ts"],
      "@nx-fullstack/shared/types": ["libs/shared/types/src/index.ts"],
      "@nx-fullstack/shared/ui": ["libs/shared/ui/src/index.ts"],
      "@nx-fullstack/shared/utils": ["libs/shared/utils/src/index.ts"],
      "@nx-fullstack/plugins/core": ["libs/plugins/core/src/index.ts"],
      "@nx-fullstack/plugins/registry": ["libs/plugins/registry/src/index.ts"],
      "@nx-fullstack/database": ["libs/database/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}